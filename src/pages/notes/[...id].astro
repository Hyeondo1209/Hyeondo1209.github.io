---
// 보고서 한 편: A4 장들이 세로로 이어진 스캔본처럼.
import Base from '../../layouts/Base.astro';
import Report from '../../components/Report.astro';
import { SITE } from '../../site.config';
import { excerpt, getNotes, url, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
---
<Base title={note.data.title} description={excerpt(note, 150)} lang={note.data.lang} noindex={note.data.unlisted} here="note">
  <Report note={note} mode="full" />
</Base>
