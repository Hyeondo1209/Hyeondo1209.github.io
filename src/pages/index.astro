---
// 첫 화면(임시): 보고서마다 첫 장만. 뒷장이 있으면 겹친 종이로 표시.
import Base from '../layouts/Base.astro';
import Report from '../components/Report.astro';
import { SITE } from '../site.config';
import { getListedNotes, url } from '../lib/notes';

const notes = await getListedNotes();
---
<Base here="home">
  <h1 class="sr-only">{SITE.homeTitle}</h1>
  <div class="reports">
    {notes.length === 0 && <p>아직 책상 위에 놓인 글이 없어요.</p>}
    {notes.map((note) => <Report note={note} mode="cover" />)}
  </div>
</Base>
