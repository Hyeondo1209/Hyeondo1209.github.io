---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../site.config';
// 미리보기에서 정하는 보기 설정 (첫 화면 종이 크기, 제목 정렬, 첫 화면 인덱스)
import SETTINGS from '../settings.json';
import { url } from '../lib/notes';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ko' | 'en';
  noindex?: boolean;
  /** 지금 페이지 (머리말 오른쪽 링크에서 자기 자신은 뺌) */
  here?: 'home' | 'list' | 'about' | 'note' | 'other';
  /** 글 페이지: 링크 미리보기에 '글'로, 쓴 날짜와 함께 */
  published?: Date;
}
const { title, description = SITE.intro, lang = 'ko', noindex = false, here = 'other', published } = Astro.props;
// 머리말 오른쪽 끝: 목록 (첫 화면은 가운데 "desk" 를 누르면)
const nav = [{ key: 'list', label: '목록', href: url('/list/') }].filter((n) => n.key !== here);
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.homeTitle;
// 카톡·슬랙·검색 결과의 링크 미리보기용
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogTitle = published && title ? title : fullTitle; // 글은 글 제목만, 나머지는 사이트 이름까지
const fonts = url('/fonts/');
// 굴림체가 없는 기기(맥, 폰)에서 대신 쓰는 조합 글꼴:
// 한글은 백묵 굴림, 영문과 숫자는 한글의 절반 폭인 나눔고딕코딩
const fontFaces = `
@font-face { font-family: 'Seorap Gulim'; src: url('${fonts}nanum-gothic-coding-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212; font-display: swap; }
@font-face { font-family: 'Seorap Gulim'; src: url('${fonts}baekmuk-gulim.woff2') format('woff2');
  unicode-range: U+1100-11FF, U+3000-303F, U+3130-318F, U+AC00-D7A3; font-display: swap; }`;
---
<!doctype html>
<html
  lang={lang}
  data-title-align={SETTINGS.titleAlign}
  data-cover-flags={SETTINGS.coverFlags}
  style={`--cover-scale:${SETTINGS.coverScale}`}
>
  <head>
    <meta charset="utf-8" />
    <!-- 폰에서도 데스크톱 화면(A4 + 오른쪽 여백)을 통째로 축소해서 보여줌. 손가락으로 확대해서 읽음 -->
    <meta name="viewport" content="width=1160" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <style is:inline set:html={fontFaces}></style>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <div class="page">
      <header class="site-head">
        <p>
          <a href={url('/about/')}>{SITE.ownerEn}</a>의 <a class="site-head__home" href={url('/')}>desk</a>
          <span class="site-head__nav">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</span>
        </p>
      </header>
      <main>
        <slot />
      </main>
      <script is:inline>
        // 사이트를 다시 올리지 않아도 오늘 날짜 기준으로 종이가 바래도록
        document.querySelectorAll('.report[data-date]').forEach(function (el) {
          var y = (Date.now() - new Date(el.dataset.date).getTime()) / (4 * 365.25 * 864e5);
          el.style.setProperty('--age', Math.min(1, Math.max(0, y)).toFixed(3));
        });
      </script>
      <script>
        import '../scripts/paginate.ts';
        import '../scripts/desk-open.ts';
      </script>
    </div>
  </body>
</html>
