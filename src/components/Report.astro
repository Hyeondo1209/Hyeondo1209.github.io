---
// 보고서 한 편. 서버에서는 글 전체를 한 덩어리로 내보내고,
// 화면에서 src/scripts/paginate.ts 가 A4 장으로 나눕니다.
// 스크립트가 꺼진 환경에서는 한 장의 긴 종이로 그대로 보입니다.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { flagColor } from '../site.config';
import { formatDate, noteUrl, url, type Note } from '../lib/notes';

interface Props {
  note: Note;
  mode: 'full' | 'cover';
}
const { note, mode } = Astro.props;
const { title, date, cover, lang } = note.data;
const subtitle = note.data.subtitle ?? [];
// 웹에서 표시를 한 제목·부제는 올리기가 만든 HTML을 씀 (수정테이프로 가린 글자는 들어 있지 않음)
const titleHtml = note.data.titleHtml;
const subtitleHtml = note.data.subtitleHtml;
const tags = note.data.tags ?? [];
const { Content } = await render(note);

// 종이 바램: 글이 오래될수록 0에서 1로. 4년이면 가장 많이 바램. (화면에서 오늘 날짜로 다시 계산)
const AGE_YEARS = 4;
// 글 페이지에서는 보고서 제목이 그 페이지의 맨 위 제목(h1). 첫 화면에서는 여러 보고서 중 하나라 h2
const Title = mode === 'full' ? 'h1' : 'h2';
// 호치키스: 실사 스캔 5개 중 하나 (글마다 다르지만 매번 같은 것)
let h = 0;
for (const ch of note.id) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const staple = h % 5;
const age = Math.min(1, Math.max(0, (Date.now() - date.getTime()) / (AGE_YEARS * 365.25 * 864e5)));
---
<article
  class="report"
  id={mode === 'full' ? note.id : `cover-${note.id}`}
  lang={lang}
  data-mode={mode}
  data-date={date.toISOString()}
  data-staple={staple}
  style={`--age:${age.toFixed(3)}`}
>
  {tags.length > 0 && (
    <ul class="flags" aria-label="인덱스">
      {tags.map((t) => (
        <li><a class={`flag flag--${flagColor(t)}`} href={url(`/list/#${encodeURIComponent(t)}`)}>{t}</a></li>
      ))}
    </ul>
  )}
  <div class="report__source">
    <p class="report__date"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    <header class="report__head">
      <Title class="report__title">
        {mode === 'cover'
          ? <a class="report__open" href={noteUrl(note)}>{titleHtml ? <Fragment set:html={titleHtml} /> : title}</a>
          : titleHtml ? <Fragment set:html={titleHtml} /> : title}
      </Title>
      {subtitleHtml
        ? subtitleHtml.map((line) => <p class="report__subtitle" set:html={line} />)
        : subtitle.map((line) => <p class="report__subtitle">{line}</p>)}
    </header>
    {cover && <Image src={cover} alt={title} widths={[640, 1280]} sizes="(max-width: 760px) 100vw, 610px" />}
    <Content />
  </div>
  <div class="report__pages"></div>
</article>
